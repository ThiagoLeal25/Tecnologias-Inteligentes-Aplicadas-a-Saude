import pandas as pd

from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.pipeline import Pipeline

from sklearn.linear_model import LogisticRegression
from sklearn.tree import DecisionTreeClassifier
from sklearn.ensemble import RandomForestClassifier, GradientBoostingClassifier
from sklearn.neighbors import KNeighborsClassifier
from sklearn.svm import SVC
from sklearn.naive_bayes import GaussianNB

from sklearn.metrics import accuracy_score, f1_score, confusion_matrix


# ============================================================
# MODELOS
# ============================================================

modelos = {
    "Regressão Logística": Pipeline([
        ("escalador", StandardScaler()),
        ("modelo", LogisticRegression(max_iter=1000))
    ]),

    "Árvore de Decisão":
        DecisionTreeClassifier(random_state=42),

    "Random Forest":
        RandomForestClassifier(
            n_estimators=300,
            random_state=42
        ),

    "Gradient Boosting":
        GradientBoostingClassifier(random_state=42),

    "KNN": Pipeline([
        ("escalador", StandardScaler()),
        ("modelo", KNeighborsClassifier(n_neighbors=5))
    ]),

    "SVM": Pipeline([
        ("escalador", StandardScaler()),
        ("modelo", SVC(
            kernel="rbf",
            random_state=42
        ))
    ]),

    "Naive Bayes":
        GaussianNB()
}


# ============================================================
# FUNÇÃO PARA TREINAR E AVALIAR
# ============================================================

def executar_problema(arquivo, nome_target):

    print("\n" + "=" * 60)
    print("ARQUIVO:", arquivo)
    print("=" * 60)

    # Carregar os dados
    dados = pd.read_csv(arquivo)

    print("\nQuantidade de registros:", len(dados))

    # Separar X e y
    X = dados.drop(columns=[nome_target])
    y = dados[nome_target]

    # Dividir os dados em treino e teste
    X_treino, X_teste, y_treino, y_teste = train_test_split(
        X,
        y,
        test_size=0.20,
        random_state=42,
        stratify=y
    )

    print("Dados de treinamento:", len(X_treino))
    print("Dados de teste:", len(X_teste))

    # Testar cada modelo
    for nome, modelo in modelos.items():

        print("\n" + "-" * 60)
        print("MODELO:", nome)
        print("-" * 60)

        # Treinar
        modelo.fit(X_treino, y_treino)

        # Previsões
        previsao_treino = modelo.predict(X_treino)
        previsao_teste = modelo.predict(X_teste)

        # ==========================
        # MÉTRICAS DE TREINAMENTO
        # ==========================

        accuracy_treino = accuracy_score(
            y_treino,
            previsao_treino
        )

        f1_treino = f1_score(
            y_treino,
            previsao_treino
        )

        # ==========================
        # MÉTRICAS DE TESTE
        # ==========================

        accuracy_teste = accuracy_score(
            y_teste,
            previsao_teste
        )

        f1_teste = f1_score(
            y_teste,
            previsao_teste
        )

        # ==========================
        # RESULTADOS
        # ==========================

        print("\nTREINAMENTO:")
        print("Accuracy:", round(accuracy_treino, 4))
        print("F1-Score:", round(f1_treino, 4))

        print("\nTESTE:")
        print("Accuracy:", round(accuracy_teste, 4))
        print("F1-Score:", round(f1_teste, 4))

        # ==========================
        # MATRIZ DE CONFUSÃO
        # ==========================

        matriz = confusion_matrix(
            y_teste,
            previsao_teste
        )

        print("\nMatriz de Confusão:")
        print(matriz)


# ============================================================
# PROBLEMA 1
# ============================================================

executar_problema(
    "/content/drive/MyDrive/dados_predicao_modelos.csv",
    "Compro_Produto"
)


# ============================================================
# PROBLEMA 2
# ============================================================

